# ============================================
# WireGuard VPN - КРИТИЧНО ДЛЯ БЕЗОПАСНОСТИ
# ============================================

# Приватные ключи WireGuard (никогда не коммитить!)
*_private.key
server_private.key
client_private.key
private.key

# Реальные конфигурации с секретами
wg0.conf
client.conf
*.conf

# ============================================
# Сетевые конфигурации с реальными IP
# ============================================

# Netplan конфиги (содержат IP, DNS, маршруты)
/etc/netplan/*.yaml
netplan.yaml

# DNS конфигурация
/etc/resolv.conf
resolv.conf

# Таблица маршрутизации (может содержать внутренние IP)
route_table.txt
ip_route.txt

# ============================================
# SSH и криптография
# ============================================

# Все SSH ключи (расширение .pub тоже лучше не светить)
*.pub
ssh_config
known_hosts

# Сертификаты и ключи TLS/SSL
*.pem
*.crt
*.key
*.cert

# ============================================
# Системные файлы Linux
# ============================================

# История команд (может содержать пароли в открытом виде)
.bash_history
.history

# Временные файлы
*.tmp
*.swp
*~

# ============================================
# Переменные окружения и секреты
# ============================================

.env
.env.local
.env.production
*.secret
credentials.json
